# User data — runtime files generated by users, not template source.
# These should not be formatted, as they may contain personal data and
# were not written by a formatter.
identity/
knowledge/
chats/

# JSONL files (newline-delimited JSON — each line is valid JSON, but the
# file as a whole is not a JSON value, so Prettier must not touch them).
*.jsonl

# npm
node_modules/
package-lock.json

# Prettier does not parse this file without an additional TOML plugin.
pyproject.toml

# Generated binary
.memory.db

# Python caches
__pycache__/
.mypy_cache/
.pytest_cache/
.venv/
